# /etc/lancoai/shop.env (root:hy2-xray 0640)
# Public host written into pages; the request Host header is only a fallback.
LANCOAI_PUBLIC_HOST=lancoai.site
# The network service's loopback session endpoint.
LANCOAI_SESSION_URL=http://127.0.0.1:8083/api/v1/session
# 0 until cutover: the monolith still refreshes state/shop. Set 1 at cutover.
SHOP_SCHEDULER=0
# Standby serves only health and static assets; no business stores or workers.
LANCOAI_STANDBY=1
