{
  "name": "hysteria-console-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint:js": "eslint \"tests/*.cjs\"",
    "lint:css": "stylelint \"frontend/src/**/*.css\"",
    "test:gates": "node --experimental-vm-modules --test --test-concurrency=1 tests/frontend-quality.test.cjs tests/overview_pagehide_state.test.cjs",
    "test:browser": "PYTHONPATH=. ${PYTHON:-python3} tests/run_react_browser.py",
    "typecheck:react": "tsc --noEmit",
    "build:react": "vite build",
    "test:react-assets": "python3 -m pytest -q tests/test_react_asset_boundary.py",
    "test:react-unit": "node --experimental-vm-modules --test tests/overview_pagehide_state.test.cjs",
    "test:react-browser": "PYTHONPATH=. ${PYTHON:-python3} tests/run_react_browser.py",
    "check:react-core": "npm run typecheck:react && npm run build:react && npm run test:react-assets && npm run test:react-unit",
    "check:react": "npm run check:react-core && npm run test:react-browser",
    "check:frontend": "npm run lint:js && npm run lint:css && npm run test:gates && npm run test:browser && npm run check:react-core"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "stylelint": "17.15.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
