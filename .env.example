# Copy to .env, run `chmod 600 .env`, and fill in real values before deploy.sh.
# .env is gitignored — NEVER commit it.

# ---- Hysteria2 ----
# Public IP or hostname clients will connect to (used in the clash template).
HY_SERVER_HOST=your.server.ip.or.host

# trafficStats API secret (also used by the subscription panel and auth backend).
# Generate with: openssl rand -hex 24
HY_API_SECRET=replace_me_with_openssl_rand_hex_24

# Salamander obfs password. Generate with: openssl rand -base64 24 | tr -d '/+='
HY_OBFS_PASSWORD=replace_me_with_random_32_chars

# Display/billing multiplier applied to raw traffic counters. Keep this aligned
# with your observed provider accounting. /admin/health suggests a calibrated
# value after enough traffic samples. Default: 2.28.
HY_DISPLAY_MULTIPLIER=2.28

# Deploy an exact, checksum-verified Hysteria release.
HY_HYSTERIA_VERSION=v2.9.3
HY_XRAY_VERSION=v26.6.27

# ---- Xray VLESS + Reality ----
# Generate a keypair with: xray x25519
XRAY_REALITY_PRIVATE_KEY=replace_me_reality_private_key
XRAY_REALITY_PUBLIC_KEY=replace_me_reality_public_key

# Short ID (hex, even length, 2-16 chars). Generate with: openssl rand -hex 8
XRAY_REALITY_SHORT_ID=replace_me_hex_8

# ---- Optional admin-panel HTTPS ----
# Domains use a normal Let's Encrypt certificate. Public IPv4 addresses use a
# six-day Let's Encrypt IP certificate and therefore require reliable renewal.
# TCP/9444 is used because Xray already owns TCP/443 and TCP/8443.
HY_ENABLE_HTTPS=1
HY_CERTBOT_EMAIL=''
HY_HTTPS_PORT=9444
