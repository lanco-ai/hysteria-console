[Unit]
Description=Hysteria Traffic Limiter Sync
Wants=network-online.target
After=network-online.target hysteria-server.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /root/hysteria/traffic_limiter.py
User=root
Group=hy2-xray
UMask=0077
TimeoutStartSec=75s
TasksMax=64
MemoryHigh=192M
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/hysteria /usr/local/etc/xray /var/log/xray
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
SystemCallArchitectures=native
