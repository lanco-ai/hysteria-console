[Unit]
Description=Hysteria Subscription Backend
Wants=network-online.target
After=network-online.target hysteria-server.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/hysteria/subscription_service.py
WorkingDirectory=/root/hysteria
User=root
Group=hy2-xray
Restart=on-failure
RestartSec=2
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
TasksMax=96
MemoryHigh=384M
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/hysteria /usr/local/etc/xray /var/log/xray
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
