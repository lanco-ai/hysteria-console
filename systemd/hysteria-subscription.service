[Unit]
Description=Hysteria Subscription Backend
After=network.target hysteria-server.service

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /root/hysteria/subscription_service.py
WorkingDirectory=/root/hysteria
User=root
Group=root
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/hysteria /usr/local/etc/xray
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
