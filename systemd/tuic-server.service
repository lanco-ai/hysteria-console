[Unit]
Description=TUIC v5 Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tuic-server --config /root/hysteria/tuic.json
WorkingDirectory=/root/hysteria
User=root
Group=root
Restart=always
RestartSec=2
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
